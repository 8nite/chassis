{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chassis-www",
  "compatibility_date": "2026-07-25",
  "workers_dev": false,
  "preview_urls": false,
  "cache": {
    "enabled": true,
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
